# dependencies
node_modules/
.tmp/

# packaged tarballs
*.tgz

# logs & env
*.log
.env
.env.*

# DSH credential stores — never commit. DSH keeps API keys and app secrets in
# these plaintext YAML documents under $DSH_HOME.
.credentials.yaml
.credentials.yaml.*
**/.credentials.yaml
**/.credentials.yaml.*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*

# ---------------------------------------------------------------------------
# Machine-specific deployment helpers. These reference real hosts, the
# systemd unit name and absolute $HOME layouts on the private servers, so they
# stay local and are never published.
# ---------------------------------------------------------------------------
scripts/
durable-install.sh
verify-hosts.sh
verify-remote.sh
cleanup-packages2.sh
