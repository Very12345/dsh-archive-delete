{
  "name": "@very12345/dsh-archive-delete",
  "version": "0.3.3",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js && node selftest-entry.cjs"
  },
  "description": "Delete archived DSH sessions with native registry and session-list synchronization, immediate sidebar removal and batch controls.",
  "license": "MIT",
  "author": "Very12345",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "session",
    "delete",
    "archive",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Very12345/dsh-archive-delete.git"
  },
  "homepage": "https://github.com/Very12345/dsh-archive-delete#readme",
  "bugs": {
    "url": "https://github.com/Very12345/dsh-archive-delete/issues"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "deletion-book.js",
    "native",
    "cordis.patch.yml",
    "selftest-entry.cjs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-api-workspace-controller": "^0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-workspace-controller": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
